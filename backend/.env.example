# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@db:5432/school_attendance

# PostgreSQL Database (for Docker Compose)
POSTGRES_DB=school_attendance
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_ISSUER=vde-attendance
JWT_AUDIENCE=vde-attendance-api
JWT_SERVER_AUDIENCE=vde-attendance-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# TRUSTED_SERVICES=service1,service2

# RSA Keys for JWT
PRIVATE_KEY_PATH=./secrets/private_key.pem
PUBLIC_KEY_PATH=./secrets/public_key.pem
# PRIVATE_KEY_PASSWORD=your-private-key-password-if-encrypted

# CORS Configuration
# BACKEND_CORS_ORIGINS=*  # Comma-separated list or * for all origins

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Server Configuration
HOST=0.0.0.0
PORT=8002
WORKERS=1
FORWARDED_ALLOW_IPS=*

# Logging Configuration
LOG_LEVEL=INFO
JSON_LOGS=true